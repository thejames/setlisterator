# Copy to .env and fill in. The script reads these via python-dotenv.
SETLISTFM_API_KEY=your-setlistfm-api-key
PLEX_BASEURL=http://localhost:32400
PLEX_TOKEN=your-plex-token
PLEX_MUSIC_LIBRARY=Music

# Web app only. Port for `python web.py` (5000 is taken by AirPlay on macOS).
PORT=5001

# Optional. Default setlist.fm username, pre-filled on the web Attended page.
SETLISTFM_USER=

# Optional. YouTube Music playlist support (web app). Needs all three: the two
# OAuth client credentials you created in Google Cloud (also passed to
# `ytmusicapi oauth`), and the token file that command writes. The client
# id/secret are required at runtime too — the token file only holds tokens, and
# ytmusicapi needs the credentials to refresh it. Leave unset to keep YTM
# disabled. YTM_OAUTH_FILE defaults to ytm_oauth.json beside history.json.
YTM_CLIENT_ID=
YTM_CLIENT_SECRET=
YTM_OAUTH_FILE=
